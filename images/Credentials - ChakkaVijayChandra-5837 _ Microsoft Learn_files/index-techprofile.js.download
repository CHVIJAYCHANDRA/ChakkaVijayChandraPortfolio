se",FF="Georgian",Yy="Kazakh",Vy="Korean",Gy="Luxembourgish",jy="Lithuanian",Wy="Latvian",Qy="Malay",Ky="Maltese",Jy="Norwegian",Xy="Dutch",Zy="Polish",ex="Portuguese",HF="Portuguese (Brazil)",zF="Portuguese (Portugal)",tx="Romanian",ox="Russian",nx="Slovak",rx="Slovenian";var ix="Serbian (Cyrillic)",ax="Serbian (Latin)",sx="Swedish",lx="Thai",cx="Turkish",dx="Ukranian",BF="Ukranian",YF="Urdu",ux="Vietnamese",VF="Vietnamese (Vietnam)";var px="Chinese (Simplified)",mx="Chinese (Traditional, Hong Kong SAR)",gx="Chinese (Traditional)";var GF="Manage cookies",Td="Manage email preferences";var jF="We are working hard to migrate your course history and achievements to Learn. At this time, however, only activity completed in Learn will appear here.",WF=`To view your full transcript and/or the badges you've earned in the Microsoft Educator Center and Learn, please go to your <a href="https://education.microsoft.com/profile">MEC profile</a>.`;var QF="Microsoft Employee Privacy Notice",KF="You have signed in with an account associated to an organization ({email}). By becoming a member, <strong>you understand and acknowledge</strong> that your Microsoft Learn membership means our network of sites and applications will record, and track your achievements and activities and we may share your results and activities with your organization. Additionally, your username, display name, profile picture, affiliation, achievements and activities will be publicly visible. You can hide your achievements and activities under settings.<br/><br/>After you create your profile, we recommend you link a personal account so that you can access your learning progress regardless of your employment status. You can link additional accounts in the Account Management section of the profile settings.";var JF="Microsoft Learn will send email to you at the email you provide below.";var Ep="Microsoft Privacy Notice",XF="You need to agree with the Microsoft Privacy Notice to keep your profile and relating data.";var aP="{numberOfMinutes} min";var fx="{numberOfMinutes} minutes";var Hf="1 minute";var Ci="Module";var sP="All module assessment results";var lP="N/A means either not all module assessments exist or there is no pass record. All Learning Paths in this table are complete.";var cP="N/A in the module assessment result column means either the module assessment doesn't exist or there's no pass record for it. All modules in this table are complete.";var dP="Module assessment passed",ZF="All module assessments passed";var uP="Module assessment result";var _a="Modules";var zf="More";var Vo="Next";var ba="No",hx="New collection",pP="Newest",mP="Oldest";var e2='No items in this section. Move items here from other sections or add items from the <a href="{link}">Learn training browse page</a>.';var t2="No suggestions";var o2="No, thanks";var Cp="{number} item",gl="{number} items";var n2="of";var gP="Off",vn="OK",r2="OK, got it.",i2="Go to the {title} page";var a2="Based on your {section} selections, start learning with the following recommendations.";var s2="Let's customize your experience on Microsoft Learn!";var l2="Explore {topic} hub pages",c2="We were unable to match your selections to recommendations",d2='Thank you for selecting the items you are interests in. Your selections are saved to your profile. Unfortunately, we do not have any matching recommendations at this time. You can "Restart from beginning" to add more selections or check back at a later date to see if our recommendations have changed for you.',u2="Oops! You did not fill out the survey",fP="In order to give you custom recommendations you must fill out the survey. Please select the link on the bottom labeled \u201CRestart from beginning\u201D to begin the survey. Answer to the best of your ability for the most accurate recommendations.",hP="If you do not want tailored recommendations at this time, you can still browse!",Bf="Browse training";var p2="Please make at least one selection";var _P="Restart from beginning";var Yf="Select all that apply",m2="Select the best response",_x="Select the option that you most identify with";var g2="Select 1-3 Products you're interested in";var f2="Select 1-3 Careers you're interested in",h2="Select 1-3 Subjects you're interested in",_2="Answer the following set of questions to the best of your ability. Knowing your interests, we will provide custom recommendations and tweak some pages of the site to reflect your interests.",b2="What are you interested in learning about?",bP="Is there something in {subtopic} you want to focus on?",v2="So, you're interested in products. Which product(s) would you like to focus on?",y2="You're interested in {experienceTopic}. What would you say your experience level is with it?",x2="So, you're interested in careers. Which career(s) would you like to focus on?",T2="You're interested in being a {experienceTopic}. What would you say your experience level is?",w2="So, you're interested in subjects. Which subject(s) would you like to focus on?",S2="You're interested in {experienceTopic}. What would you say your experience level is?",E2="What would you say is your current career level?",C2="Just getting started (0 years)",A2="Early career (0 - 5 years)",k2="Mid career (5 - 10 years)",P2="Advanced career (10+ years)",I2="What type of training content do you want to engage with?",L2="Self-paced (online)",R2="Instructor-led (in-person/virtual)";var Vf="On this page";var M2="Open search";var D2='I will receive information via email related to my use of Microsoft Learn. To learn more about how Microsoft handles your personal data please visit the <a href="https://go.microsoft.com/fwlink/?LinkId=521839">Microsoft Privacy Statement.</a>',N2="I would like to receive information via email related to my use of Microsoft Learn. To learn more about how Microsoft handles your personal data please visit the Microsoft Privacy Statement.",$2='I would like to receive information via email related to my use of Microsoft Learn. To learn more about how Microsoft handles your personal data please visit the <a href="https://go.microsoft.com/fwlink/?LinkId=521839">Microsoft Privacy Statement.</a>',U2="I would like to receive information via email related to my use of Microsoft Learn. To learn more about how Microsoft handles your personal data please visit the Microsoft Privacy Statement.",O2='I would like to receive information via email related to my use of Microsoft Learn. To learn more about how Microsoft handles your personal data please visit the <a href="https://go.microsoft.com/fwlink/?LinkId=521839">Microsoft Privacy Statement.</a>',q2='Participation requires transferring your personal data to other countries in which Microsoft operates, including the United States. By submitting this form, you agree to the transfer of your data outside of China. <a href="https://go.microsoft.com/fwlink/?LinkId=521839">Privacy Statement.</a>',vP="I agree to receiving marketing information and use of my personal information for marketing purposes (required):",F2='<div class="content"><ul><li><span class="font-weight-bold font-size-lg">Consent to Receive Marketing</span>: The information collected may be used for Microsoft to send you information, tips, and offers about Microsoft Learn and other Microsoft products and services. </li><li> Items of Personal Information to be Collected: First Name, Last Name, Email Address, Phone Number, Company name and size, Job Title, Country/Region of residence, and any other fields visible on this form. </li><li>Purpose of Collection and Use: <span class="font-weight-bold font-size-lg">To contact you for marketing purposes </span></li><li> Retention/Use Period of Personal Information: <span class="font-weight-bold font-size-lg">As long as needed to provide the service(s) you are requesting </span></li></ul></div> You have the right to refuse the collection and use of personal information for marketing purposes, and receiving marketing information as set forth above. However, if you refuse, you may not be able to receive the benefits described under Purpose of Collection & Use. <a href="https://go.microsoft.com/fwlink/?LinkId=521839">Privacy Statement.</a>';var Ap="Select a country/region";var kp="Skills measured";var H2="Optional";var bx="{label} (optional)";var yP="Other";var vx="Page {pageNumber} of {numberOfPages}";var z2="pagination";var Gf="Past {numberOfDays} days";var jr="Plan";var B2="Please fill out this field.",Pp="Please provide an email address.";var Y2="Print";var yx="Preview";var Ip="Previous";var V2="Private";var G2="{productName} users:";var jf="Profile",xx='Ask or answer a question in <a href="https://learn.microsoft.com/answers">the community</a>',Wf='Catch up on the latest <a href="https://techcommunity.microsoft.com/t5/microsoft-learn-blog/bg-p/MicrosoftLearnBlog">site news</a>',j2="Cloud Skills Challenge",Qf='Explore <a href="https://learn.microsoft.com/docs/">the documentation</a>',Kf='Learn skills with <a href="https://learn.microsoft.com/training">step-by-step guidance</a>';var W2="Complete a learning path or module to get a trophy or badge. Your achievements will show here.",Q2="Start learning new skills. Your activities will show here.",K2="Welcome back! We haven't seen you in a while. Start learning new skills.";var xP="Start learning new skills.",J2="When you complete a challenge, your achievements will show up here.";var X2="When you complete a course, your achievements will show up here.",Z2="When you participate in Microsoft Learn events, contribute to Microsoft Learn content, or engage in other initiatives, your achievements will show up here.",eH="When you complete a plan, your achievements will show up here.";var tH="Follow your favorite threads, tags, and users.",oH="When you complete a learning path, your achievements will show up here.",nH="When you complete a module, your achievements will show up here.";var rH="Start learning new skills.",iH="Complete a learning path or module and a t